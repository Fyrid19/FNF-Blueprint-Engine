package;

import hxp.*;

import lime.tools.*;

class Project extends HXProject {
	final COMPANY_NAME:String = "KayNet";
	final PACKAGE_NAME:String = "com.KayNet.BlueprintEngine";
	
	final WINDOW_TITLE:String = "Blueprint Engine";
	
	final FILE_NAME:String = "BlueprintEngine";
	final VERSION:String = "0.1.0";
	
	final MAIN:String = "Main";
	
	final EXPORT_PATH:String = "export";
	final SOURCE_PATH:String = "source";
	
	public function new() {
		super();
		
		sources.push(SOURCE_PATH);
		
		setDefines();
		addLibraries();
		
		includeAssets("assets", "assets", ["*"], [isWeb() ? "*.ogg" : "*.mp3"]);
		if (isDef("MOD_SUPPORT")) includeAssets("mods", "mods");
		
		appConfig();
	}
	
	function appConfig() {
		app.main = MAIN;
		app.file = FILE_NAME;
		app.path = EXPORT_PATH;
		
		meta.title = WINDOW_TITLE;
		meta.packageName = PACKAGE_NAME;
		meta.version = VERSION;
		meta.company = COMPANY_NAME;
		
		window.width = 1280;
		window.height = 720;
		window.fps = 60;
		
		window.background = 0xFF000000;
		window.hardware = true;
		window.fullscreen = false;
		window.resizable = true;
		window.borderless = false;
		window.vsync = false;
		window.orientation = Orientation.LANDSCAPE;
		window.antialiasing = 1;
		
		setIcons();
	}
	
	function addLibraries() {
		addLib('flixel');
		addLib('flixel-addons');
		addLib('flixel-tools');
		addLib('flixel-ui');
		
		addLib('flixel-animate');
		
		addLib('FlxPartialSound');
		
		addLib('toml.hx');
		addLib('json5hx');
		
		if (isDef("DISCORD_RPC"))
			addLib('hxdiscord_rpc');
	}
	
	function setIcons() {
		addIcon('art/icons/icon16.png', 16);
		addIcon('art/icons/icon32.png', 32);
		addIcon('art/icons/icon64.png', 64);
		addIcon('art/icons/iconOG.png');
	}
	
	function setDefines() {
		setDef("MOD_SUPPORT");

		if (!isWeb()) {
			setDef("PRELOAD_ALL");
		}
		
		if (isDesktop()) {
			setDef("CRASH_HANDLER");
			setDef("DISCORD_RPC");
		}

		setHaxeDef("FLX_NO_FOCUS_LOST_SCREEN");

		if (!debug) {
			setHaxeDef("FLX_NO_DEBUG");
			setHaxeDef("NAPE_RELEASE_BUILD");
		}
		
		setHaxeDef("no-deprecation-warnings");
		setHaxeDef("hscriptPos", "true");
	}
	
	function setHaxeDef(name:String, ?value:String = "")
		haxedefs.set(name, value);
	
	function getHaxeDef(name:String) 
		return haxedefs.get(name);

	function setDef(name:String, ?value:String = "") 
		defines.set(name, value);

	function getDef(name:String) 
		return defines.get(name);

	function isDef(name:String)
		return defines.exists(name);
	
	function addIcon(name:String, ?size:Int) {
		icons.push(new Icon(name, size));
	}
	
	function addLib(name:String) {
		haxelibs.push(new Haxelib(name));
	}
	
	function isCPP()
		return defines.exists("cpp");
		
	function isDesktop()
		return platformType == PlatformType.DESKTOP;
		
	function isWeb()
		return platformType == PlatformType.WEB;
		
	function isWindows()
		return target == Platform.WINDOWS;
		
	function isLinux()
		return target == Platform.LINUX;
		
	function isMac()
		return target == Platform.MAC;
}
